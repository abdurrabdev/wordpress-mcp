APP_ENV=production
APP_SECRET_KEY=replace_with_a_long_random_secret

# Bootstrap site. On first startup these create the first site profile.
# After that, change sites from /admin/sites instead of editing .env.
WP_BASE_URL=https://xhunta.com
WP_USERNAME=your_wordpress_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Protect the MCP endpoint at your reverse proxy/API gateway.
# Use a long random value.
MCP_AUTH_TOKEN=replace_with_a_long_random_secret

# Protect the browser admin dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Abd@873442

REQUEST_TIMEOUT=60
MAX_UPLOAD_SIZE=26214400

# Optional bootstrap WooCommerce API credentials.
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# SQLite default. For FastAPI Cloud persistent storage, configure a persistent
# volume or use an external PostgreSQL database if the platform configuration requires it.
DATABASE_URL=sqlite:///./wordpress_mcp.db
